{
  "name": "ashbound",
  "version": "0.1.0",
  "description": "An autonomous AI agent that can inhabit interactive environments",
  "main": "dist/index.js",
  "bin": { "ashbound": "dist/index.js" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/agent.test.ts",
    "test:unit": "tsx --test tests/unit/agent.test.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "license": "MIT",
  "keywords": ["ashbound", "minecraft", "discord", "ai", "agent", "autonomous"],
  "engines": { "node": ">=22" },
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "allowScripts": { "better-sqlite3@13.0.3": true }
}
