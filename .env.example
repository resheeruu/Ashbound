DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
DATABASE_URL=file:./data/ashbound.db
DEFAULT_MINECRAFT_VERSION=1.21.4
LOG_LEVEL=info
PORT=9002
NODE_ENV=development

# Resource Limits
MAX_SESSIONS_PER_GUILD=1
MAX_MINECRAFT_SESSIONS=1
MAX_ACTIVE_GOALS_PER_SESSION=1
MAX_CONCURRENT_AI_REQUESTS=1
MAX_CONCURRENT_ACTIONS_PER_SESSION=1
MAX_RECONNECT_ATTEMPTS=3

# Security
ALLOW_PAID_AI=false
PUBLIC_RESPONSE_MODE=MENTION_ONLY
PUBLIC_MINECRAFT_CONTROL=false
MAX_CONVERSATION_MESSAGES=20
MAX_MEMORY_RESULTS=10
DATABASE_MAX_SIZE_MB=350
LOG_MAX_SIZE_MB=50
LOG_RETENTION_DAYS=7

# Autonomy
DEFAULT_AUTONOMY_MODE=ASSISTED
