# Discord (required)
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_GUILD_ID=optional_guild_id_for_dev

# Owner (required for web search/fetch tools)
DISCORD_OWNER_ID=your_discord_user_id

# AI Providers (at least one recommended)
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key
MISTRAL_API_KEY=your_mistral_key
DEEPSEEK_API_KEY=your_deepseek_key
OPENROUTER_API_KEY=your_openrouter_key
XAI_API_KEY=your_xai_key
COHERE_API_KEY=your_cohere_key
CEREBRAS_API_KEY=your_cerebras_key
NVIDIA_API_KEY=your_nvidia_key
GITHUB_TOKEN=your_github_token
# Cloudflare: use "account_id:api_token" format
CLOUDFLARE_API_TOKEN=your_cloudflare_account_id:your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
HF_TOKEN=your_huggingface_token
OPENCODEZEN_API_KEY=your_opencodezen_key
ZHIPU_API_KEY=your_zhipu_key
# Zhipu console hint: "console" (default) or "zai" for z.ai endpoint
ZHIPU_CONSOLE=

# FreeLLMAPI providers (all optional — enable by setting the API key)
BAI_API_KEY=your_bai_key
ANYAPI_API_KEY=your_anyapi_key
OLLAMACLOUD_API_KEY=your_ollamacloud_key
LLM7_API_KEY=your_llm7_key
AGNES_API_KEY=your_agnes_key
REKA_API_KEY=your_reka_key
SILICONFLOW_API_KEY=your_siliconflow_key
ROuTEWAY_API_KEY=your_routeway_key
BAZAARLINK_API_KEY=your_bazaarlink_key
AINATIVE_API_KEY=your_ainative_key
AION_API_KEY=your_aion_key
REQUESTY_API_KEY=your_requesty_key
NAVY_API_KEY=your_navy_key
NARA_API_KEY=your_nara_key
SEALION_API_KEY=your_sealion_key
ORCAROUTER_API_KEY=your_orcarouter_key
UNOROUTER_API_KEY=your_unorouter_key
XKIRO_API_KEY=your_xkiro_key
MODELSCOPE_API_KEY=your_modelscope_key
QIANFAN_API_KEY=your_qianfan_key
VOLCENGINE_API_KEY=your_volcengine_key
LONGCAT_API_KEY=your_longcat_key
XFYUN_API_KEY=your_xfyun_key

# Keyless providers (no API key needed — just enable via AI_PROVIDER)
# aihorde, kilo, ovh — use with AI_PROVIDER=aihorde|kilo|ovh

# Ollama (local, no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Custom OpenAI-compatible endpoint (optional)
CUSTOM_BASE_URL=http://localhost:8080
CUSTOM_API_KEY=optional_key
CUSTOM_MODEL=auto
CUSTOM_PROVIDER_NAME=My Custom Provider
CUSTOM_TIMEOUT_MS=120000

# AI routing
AI_PROVIDER=openai
AI_FALLBACK=none
AI_STREAM_TIMEOUT_MS=120000
AI_REQUEST_TIMEOUT_MS=60000

# FreeLLMAPI — optional OpenAI-compatible gateway
# Aggregates free LLM providers behind a single /v1 endpoint.
# May be self-hosted (see https://github.com/tashfeenahmed/freellmapi)
# or pointed at any compatible deployment.
FREELLMAPI_ENABLED=true
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_TIMEOUT_MS=60000

# Server
PORT=3000
NODE_ENV=development
